{
  "name": "assize",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assize": "tsx packages/verifier/src/cli.ts",
    "audit:ui": "node scripts/ui-audit.mjs",
    "build": "pnpm -r --if-present build",
    "check:done": "tsx scripts/done-check.ts",
    "check:live": "node scripts/live-check.mjs",
    "check:no-address-literals": "tsx scripts/checks/no-address-literals.ts",
    "check:paths": "tsx scripts/checks/no-absolute-paths.ts",
    "check:vocabulary": "tsx scripts/checks/vocabulary.ts",
    "claim:verify": "tsx packages/claim-ledger/src/verify.ts",
    "evidence:report": "tsx scripts/evidence-report.ts",
    "lint:contracts": "forge lint contracts/src",
    "preflight": "tsx scripts/preflight.ts",
    "probe:all": "tsx scripts/probe-all.ts",
    "probe:dreamdex": "tsx scripts/probe-dreamdex.ts",
    "probe:reactivity": "tsx scripts/probe-reactivity.ts",
    "skills:verify": "tsx scripts/skills-verify.ts",
    "submission:check": "tsx scripts/submission-check.ts",
    "test": "vitest run",
    "test:differential": "tsx scripts/differential.ts",
    "test:e2e": "tsx scripts/e2e.mjs",
    "typecheck": "tsc --build --force",
    "verify:testnet": "tsx scripts/verify-testnet.ts"
  },
  "devDependencies": {
    "@assize/protocol-types": "workspace:*",
    "@assize/reference": "workspace:*",
    "@types/node": "^22.20.2",
    "lucide-static": "^1.43.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.55",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "@assize/verifier": "workspace:*"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.29.0",
    "@somnia-chain/reactivity-contracts": "0.2.1"
  }
}
