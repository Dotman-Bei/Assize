# Assize environment. Copy to .env.local and fill in. Never commit a filled file.
# Testnet only. A mainnet RPC in this file is a rule violation, not a shortcut.

# --- Network ---------------------------------------------------------------
SOMNIA_RPC_URL=
SOMNIA_WS_URL=
SOMNIA_CHAIN_ID=
# Read at deploy time and asserted at runtime, never compiled in (PRD §17).
# Discover with: pnpm probe:reactivity
SOMNIA_REACTIVITY_PRECOMPILE=

# --- DreamDEX --------------------------------------------------------------
# Which market to cover. Runtime configuration, not a protocol constant.
# Discover ids with: pnpm probe:dreamdex
DREAMDEX_MARKET_ID=
DREAMDEX_SDK_ENV=
# Package name the probe imports to read market metadata. Resolved by name at
# runtime so no package name is compiled in either. Must be pinned in
# skills-lock.json by source, path and SHA-256 before use (AGENTS.md).
DREAMDEX_SDK_PACKAGE=

# --- Deployment ------------------------------------------------------------
# Written by the deploy script. Read at runtime, never hardcoded in source.
ASSIZE_REGISTRY_ADDRESS=
ASSIZE_SUBSCRIBER_ADDRESS=

# --- Sampler ---------------------------------------------------------------
# REACTIVITY is the primary path. KEEPER is the labelled fallback (PRD §26 K1).
SAMPLER_MODE=REACTIVITY
KEEPER_CADENCE_SECONDS=
KEEPER_ADDRESS=

# --- Keys ------------------------------------------------------------------
# Never commit. Never log. Never print in an agent transcript.
MAKER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_EXPLORER_BASE_URL=
NEXT_PUBLIC_FAUCET_URL=
