# Assize environment. Copy to .env.local and fill in. Never commit a filled file.
# Testnet only. A mainnet RPC in this file is a rule violation, not a shortcut.

# --- Network ---------------------------------------------------------------
# Somnia Shannon testnet. Values below are the defaults named in the pinned
# starter template's .env.example and confirmed by a live eth_chainId.
# Testnet only: a mainnet endpoint here is a rule violation (PRD §25).
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_CHAIN_ID=50312
# The Somnia on-chain reactivity precompile, documented at 0x0100 in the pinned
# reactivity reference. Configuration rather than a source constant (PRD §17).
# Its deployed bytecode is empty by design — a precompile lives in the node — so
# `pnpm probe:reactivity` proves it is there via somnia_reactivityGetSubscriptions.
SOMNIA_REACTIVITY_PRECOMPILE=0x0000000000000000000000000000000000000100

# --- DreamDEX --------------------------------------------------------------
# Which market to cover. Runtime configuration, not a protocol constant.
# Discover ids with: pnpm probe:dreamdex
# A bytes32 market id. Markets roll on 5, 15 and 60 minute windows, so any id
# here goes stale — which is why PRD §17 makes this configuration rather than a
# constant. Discover live ids with: pnpm probe:dreamdex
DREAMDEX_MARKET_ID=
# The SDK requires an indexer URL at construction even when every read is
# on-chain. Public Shannon endpoint, from the pinned template's .env.example.
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# --- Deployment ------------------------------------------------------------
# Written by the deploy script. Read at runtime, never hardcoded in source.
ASSIZE_REGISTRY_ADDRESS=
# A CONTRACT address, printed by the deploy script. It cannot claim from a
# faucet: fund it by transfer from the deployer after deployment. It must hold
# SUBSCRIPTION_OWNER_MINIMUM_BALANCE before subscribe() will succeed, and must
# stay above (gas price + priorityFeePerGas) * gasLimit at every firing or the
# subscription is REMOVED, not merely skipped (DECISIONS.md D-020).
ASSIZE_SUBSCRIBER_ADDRESS=

# --- Sampler ---------------------------------------------------------------
# REACTIVITY is the primary path. KEEPER is the labelled fallback (PRD §26 K1).
SAMPLER_MODE=REACTIVITY
KEEPER_CADENCE_SECONDS=
KEEPER_ADDRESS=

# --- Keys ------------------------------------------------------------------
# Never commit. Never log. Never print in an agent transcript.
#
# TWO SEPARATE ACCOUNTS, deliberately (DECISIONS.md D-019). The registry's owner
# can register a keeper, and a registered keeper can write samples directly. One
# key holding both roles could therefore stand behind a commitment and fabricate
# the samples that judge it. Block pinning makes that detectable but not
# impossible, and the product's claim is that a stranger can re-derive a verdict,
# not that our conduct can be audited afterwards.
#
# DEPLOYER: deploys the registry and subscriber, and becomes the registry owner.
DEPLOYER_PRIVATE_KEY=
# MAKER: posts bonds and quotes the market. Labelled PROJECT_BASELINE everywhere
# it appears, and never counted as adoption (AGENTS.md).
MAKER_PRIVATE_KEY=
# KEEPER: fallback path only, used if PRD §26 K1 fires. Leave unset otherwise —
# an unregistered keeper is one fewer way for a sample to be written.
KEEPER_PRIVATE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_EXPLORER_BASE_URL=
NEXT_PUBLIC_FAUCET_URL=
