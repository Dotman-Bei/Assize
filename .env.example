# Assize environment. Copy to .env.local and fill in. Never commit a filled file.
# Testnet only. A mainnet RPC in this file is a rule violation, not a shortcut.

# --- Network ---------------------------------------------------------------
# Somnia Shannon testnet. Values below are the defaults named in the pinned
# starter template's .env.example and confirmed by a live eth_chainId.
# Testnet only: a mainnet endpoint here is a rule violation (PRD §25).
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_CHAIN_ID=50312
# Read at deploy time and asserted at runtime, never compiled in (PRD §17).
# Not yet known: the Somnia reactivity reference is the one item in AGENTS.md
# §0.2's pinning list that has not been supplied, so this address has not been
# read from any pinned source. See DECISIONS.md D-014.
SOMNIA_REACTIVITY_PRECOMPILE=

# --- DreamDEX --------------------------------------------------------------
# Which market to cover. Runtime configuration, not a protocol constant.
# Discover ids with: pnpm probe:dreamdex
# A bytes32 market id. Markets roll on 5, 15 and 60 minute windows, so any id
# here goes stale — which is why PRD §17 makes this configuration rather than a
# constant. Discover live ids with: pnpm probe:dreamdex
DREAMDEX_MARKET_ID=
# The SDK requires an indexer URL at construction even when every read is
# on-chain. Public Shannon endpoint, from the pinned template's .env.example.
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# --- Deployment ------------------------------------------------------------
# Written by the deploy script. Read at runtime, never hardcoded in source.
ASSIZE_REGISTRY_ADDRESS=
ASSIZE_SUBSCRIBER_ADDRESS=

# --- Sampler ---------------------------------------------------------------
# REACTIVITY is the primary path. KEEPER is the labelled fallback (PRD §26 K1).
SAMPLER_MODE=REACTIVITY
KEEPER_CADENCE_SECONDS=
KEEPER_ADDRESS=

# --- Keys ------------------------------------------------------------------
# Never commit. Never log. Never print in an agent transcript.
MAKER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_EXPLORER_BASE_URL=
NEXT_PUBLIC_FAUCET_URL=
